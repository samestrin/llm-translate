# --- Model endpoint (any OpenAI-compatible API, local or cloud) ---
LLM_BASE_URL="https://api.openai.com/v1" # e.g. https://api.groq.com/openai/v1, https://openrouter.ai/api/v1, http://localhost:11434/v1
LLM_API_KEY="YOUR_API_KEY"               # Leave empty for endpoints that need no key
LLM_TRANSLATE_MODEL="gpt-4.1-mini-2025-04-14" # Fast model that translates
LLM_REVIEW_MODEL=""                      # Reasoning model that reviews; empty = same as LLM_TRANSLATE_MODEL
LLM_TIMEOUT="60"                         # Seconds per model request
LLM_MAX_CONCURRENCY="4"                  # Most model requests in flight at once

# --- Optional attribution headers (OpenRouter shows these) ---
SITE_URL=""  # Sent as HTTP-Referer when set
SITE_NAME="" # Sent as X-Title when set

# --- Legacy vendor variables (still read; prefer the LLM_* variables above) ---
# Any LLM_* variable you set wins. For one you leave unset, AI_SOURCE picks a vendor
# and its variables fill it in:
#   AI_SOURCE="openai" | "groq" | "openrouter" -> LLM_BASE_URL (that vendor's endpoint)
#   OPENAI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY -> LLM_API_KEY
#   OPENAI_MODEL / GROQ_MODEL / OPENROUTER_MODEL -> LLM_TRANSLATE_MODEL
# AI_SOURCE="openai"

# --- TTS Service Selection ---
TTS_SOURCE="openai"

# --- TTS Model Configuration ---
TTS_MODEL="gpt-4o-mini-tts"

# --- TTS Credentials ---
# TTS_SOURCE="openai" reads OPENAI_API_KEY; TTS_SOURCE="groq" reads GROQ_API_KEY.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# --- Logging Configuration ---
LOG_LEVEL="INFO" # Options: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
