# Optional. `docker compose up` reads a `.env` next to docker-compose.yml; copy
# this file there and fill in a key, or pass the variables on the command line:
#   LLM_API_KEY=sk-... docker compose up --build
# Without a key the page loads and says no key is set. More settings (timeouts,
# review model, speech) go in backend/.env; see backend/.env.example.

# Any OpenAI-compatible endpoint, e.g. https://api.groq.com/openai/v1,
# https://openrouter.ai/api/v1, or http://host.docker.internal:11434/v1 for Ollama.
LLM_BASE_URL=https://api.openai.com/v1
# Leave empty for endpoints that need no key.
LLM_API_KEY=
LLM_TRANSLATE_MODEL=gpt-4.1-mini-2025-04-14
